# PayOS Environment Configuration Template

# PayOS Configuration
# Get these values from your PayOS dashboard: https://payos.vn/en/
PAYOS_CLIENT_ID=your_payos_client_id_here
PAYOS_API_KEY=your_payos_api_key_here
PAYOS_CHECKSUM_KEY=your_payos_checksum_key_here

# Application Base URL (used for payment return/cancel URLs)
APP_URL=http://localhost:3000

# Database Connection (if using separate .env file)
# DATABASE_URL=postgresql://user:password@localhost:5432/classroom_db
