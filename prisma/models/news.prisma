model news {
  news_id     Int     @id @default(autoincrement())
  class_id    Int
  user_post_id Int?
  title       String  @db.VarChar(255)
  content     String? @db.Text
  media_url   String? @db.VarChar(255)
  status      String? @db.VarChar(50)
  audience    String? @default("all") @db.VarChar(50)
  is_pinned   Boolean? @default(false)
  uploaded_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @db.Timestamp(6)
  approved_by Int?
  approved_at DateTime? @db.Timestamp(6)

  classroom        classroom @relation(fields: [class_id], references: [class_id], onDelete: Cascade)
  user_post        USER?     @relation("UserPosts", fields: [user_post_id], references: [user_id], onDelete: NoAction)
  approved_by_user USER?     @relation("ApprovedNews", fields: [approved_by], references: [user_id], onDelete: NoAction)
  comments         comment[]

  @@map("news")
}

