model message {
  message_id      Int       @id @default(autoincrement())
  conversation_id Int
  sender_id       Int
  body            String?   @db.Text
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  edited_at       DateTime? @db.Timestamp(6)
  deleted_at      DateTime? @db.Timestamp(6)

  conversation       conversation         @relation(fields: [conversation_id], references: [conversation_id], onDelete: Cascade, onUpdate: NoAction)
  sender             USER                 @relation("MessageSender", fields: [sender_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  message_attachment message_attachment[]
  message_read       message_read[]

  @@index([conversation_id, created_at])
  @@index([sender_id])
}
