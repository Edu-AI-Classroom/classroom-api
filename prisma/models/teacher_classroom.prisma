model teacher_classroom {
  teacher_id Int
  class_id   Int
  added_at   DateTime? @default(now()) @db.Timestamp(6)
  is_owner   Boolean   @default(false)

  classroom classroom @relation(fields: [class_id], references: [class_id], onDelete: Cascade, onUpdate: NoAction)
  USER      USER      @relation(fields: [teacher_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  conversation conversation[]

  @@id([teacher_id, class_id])
}

