model submission_ans {
  attempt_id  Int
  block_id    String @db.Char(36)

  // MCQ:   {"index": 2}
  // SHORT: {"text": "..."}
  // ESSAY: {"text": "..."}
  student_answer Json?
  score          Decimal?  @db.Decimal(5, 2)
  feedback       String?   @db.Text

  // AI grading: pending_review = AI đã chấm, chờ teacher verify
  // verified = teacher đã xác nhận
  grading_status String?   @default("pending") @db.VarChar(50)
  answered_at    DateTime  @default(now()) @db.Timestamp(6)

  student_submission student_submission @relation(fields: [attempt_id], references: [attempt_id], onDelete: NoAction, onUpdate: NoAction)
  block              document_block     @relation(fields: [block_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([attempt_id, block_id])
  @@index([attempt_id])
}

