model document_chunk {
  id           String    @id @default(uuid()) @db.Char(36)
  document_id  String    @db.Char(36)
  chunk_index  Int
  chunk_type   ChunkType @default(PARAGRAPH)
  page_start   Int?
  page_end     Int?
  chapter      String?   @db.VarChar(255)
  section      String?   @db.VarChar(255)
  raw_text     String
  embedding_id String?   @unique @db.Char(36)
  embedded     Boolean   @default(false)
  embedded_at  DateTime? @db.Timestamp(6)
  token_count  Int?
  created_at   DateTime  @default(now()) @db.Timestamp(6)

  document         document       @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sourced_contents content_bank[]

  @@unique([document_id, chunk_index])
  @@index([document_id])
  @@index([embedding_id])
  @@index([embedded])
}
