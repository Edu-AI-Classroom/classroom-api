model student_report {
  student_id           Int
  class_id             Int
  total_assessment     Int?
  completed_assessment Int?
  avg_score            Decimal?  @db.Decimal(5, 2)
  updated_at           DateTime? @db.Timestamp(6)

  classroom classroom @relation(fields: [class_id], references: [class_id], onDelete: NoAction, onUpdate: NoAction)
  student   student   @relation(fields: [student_id], references: [student_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([student_id, class_id])
}

