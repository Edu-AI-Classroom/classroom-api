model audit_log {
  log_id     String   @id @default(uuid()) @db.Char(36)
  user_id    Int?
  role       String? @db.VarChar(50)
  table_name String? @db.VarChar(100)
  record_id  Int?
  feature    String? @db.VarChar(100)
  action     String? @db.VarChar(100)
  old_value  String?
  new_value  String?
  client_ip  String? @db.VarChar(45)
  user_agent String?
}

