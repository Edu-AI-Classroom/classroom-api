model parent_student {
  parent_id    Int
  student_id   Int
  relationship String?   @db.VarChar(50)
  linked_at    DateTime? @default(now()) @db.Timestamp(6)
  status       String    @default("ACTIVE") @db.VarChar(50)

  parent  parent  @relation(fields: [parent_id], references: [parent_id], onDelete: Cascade, onUpdate: NoAction)
  student student @relation(fields: [student_id], references: [student_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([parent_id, student_id])
  @@index([student_id])
  @@index([status])
}
