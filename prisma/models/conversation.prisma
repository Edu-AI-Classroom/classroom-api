model conversation {
  conversation_id Int       @id @default(autoincrement())
  conversation_type String  @default("PARENT_TEACHER") @db.VarChar(50)
  class_id        Int
  student_id      Int
  parent_id       Int?
  teacher_id      Int
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  updated_at      DateTime? @db.Timestamp(6)
  last_message_at DateTime? @db.Timestamp(6)

  classroom         classroom         @relation(fields: [class_id], references: [class_id], onDelete: Cascade, onUpdate: NoAction)
  student           student           @relation(fields: [student_id], references: [student_id], onDelete: Cascade, onUpdate: NoAction)
  parent            parent?           @relation(fields: [parent_id], references: [parent_id], onDelete: Cascade, onUpdate: NoAction)
  teacher_classroom teacher_classroom @relation(fields: [teacher_id, class_id], references: [teacher_id, class_id], onDelete: Cascade, onUpdate: NoAction)
  message           message[]

  @@index([conversation_type])
  @@index([parent_id])
  @@index([student_id, class_id])
  @@index([teacher_id, class_id])
  @@index([last_message_at])
}
