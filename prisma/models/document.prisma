model document {
  id     String         @id @default(uuid()) @db.Char(36)
  title  String         @db.VarChar(255)
  type   DocumentType
  status DocumentStatus @default(DRAFT)
  note   String?        @db.Text

  grade_level Int
  subject_id  Int
  owner_id    Int
  class_id    Int?

  chunk_count Int @default(0) // số lượng block đã chia nhỏ, dùng để tracking tiến độ chunking
  quiz_count  Int @default(0) // số lượng block có quiz, dùng để tracking tiến độ tạo quiz

  source_file_url   String?                  @db.VarChar(500)
  source_file_type  String?                  @db.VarChar(20)
  ingestion_status  DocumentIngestionStatus? @default(PENDING)
  ingestion_error   String?
  ingestion_done_at DateTime?                @db.Timestamp(6)

  // Khi document được PUBLISHED, set timestamp này
  // Status = PUBLISHED → không cho phép sửa bất kỳ field nào
  published_at DateTime? @db.Timestamp(6)

  // Track document này được duplicate từ document nào
  // NULL = tạo mới từ đầu
  duplicated_from String? @db.Char(36)

  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @db.Timestamp(6)

  // Relations
  owner           USER       @relation(fields: [owner_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  subject         subject    @relation(fields: [subject_id], references: [subject_id], onDelete: NoAction, onUpdate: NoAction)
  classroom       classroom? @relation(fields: [class_id], references: [class_id], onDelete: NoAction, onUpdate: NoAction)
  source_document document?  @relation("DocumentDuplicate", fields: [duplicated_from], references: [id], onDelete: NoAction, onUpdate: NoAction)
  duplicates      document[] @relation("DocumentDuplicate")

  blocks      document_block[]
  chunks      document_chunk[]
  assessments assessment[]
  quiz_meta   quiz_meta?

  @@index([owner_id])
  @@index([class_id])
  @@index([subject_id, grade_level])
  @@index([ingestion_status])
}
