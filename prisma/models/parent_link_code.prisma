model parent_link_code {
  code                  String    @id @db.VarChar(32)
  student_id            Int
  created_by_student_id Int
  expires_at            DateTime  @db.Timestamp(6)
  used_at               DateTime? @db.Timestamp(6)
  used_by_parent_id     Int?
  is_revoked            Boolean   @default(false)
  created_at            DateTime  @default(now()) @db.Timestamp(6)

  student        student @relation(fields: [student_id], references: [student_id], onDelete: Cascade, onUpdate: NoAction)
  used_by_parent USER?   @relation("ParentLinkCodeUsedBy", fields: [used_by_parent_id], references: [user_id], onDelete: SetNull, onUpdate: NoAction)

  @@index([student_id, expires_at])
  @@index([used_by_parent_id])
}
