generator client {
  provider = "prisma-client-js"
}

// Uncomment the following block to enable ERD generation with prisma-erd-generator
// generator erd {
//   provider = "prisma-erd-generator"
//   output = "../erd.svg"
// }

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum DocumentType {
  EXAM
  LESSON
  ASSIGNMENT
}

enum DocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BlockType {
  QUESTION
  READING
  INSTRUCTION
  MEDIA
  SPACER
}

enum SemanticRole {
  MCQ
  SHORT_ANSWER
  ESSAY
  FILL_BLANK
  READING_PASSAGE
  INSTRUCTION
  MEDIA
  BLANK
}

enum ContentType {
  VIDEO
  IMAGE
  AUDIO
  QUIZ_MCQ
  QUIZ_SHORT
  READING
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

