{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug classroom-api with Nx",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "nx", "serve", "classroom-api"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/dist/apps/classroom-api/**/*.js"],
      "cwd": "${workspaceFolder}",
      "outputCapture": "console"
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach Debugger (Port 9229)",
      "port": 9229,
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/dist/apps/classroom-api/**/*.js"]
    }
  ]
}
